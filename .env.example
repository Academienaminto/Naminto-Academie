# Base de données PostgreSQL
# Si l'hébergeur passe par un pooler (ex. Supabase, PgBouncer) : DATABASE_URL
# doit pointer vers le pooler (runtime app), DIRECT_URL vers une connexion
# directe/session (nécessaire pour `prisma migrate`, verrous de session).
DATABASE_URL="postgresql://user:password@localhost:5432/naminto_academie"
DIRECT_URL="postgresql://user:password@localhost:5432/naminto_academie"

# Redis (files d'attente / tâches planifiées) — non câblé actuellement
# (bullmq/ioredis retirés de package.json le 23/08/2026, aucune feature ne
# les utilisait). Le traitement des délais utilise un déclencheur cron
# externe à la place (voir .github/workflows/deadlines-cron.yml). Ne
# réintroduire cette variable que si un vrai besoin de file de tâches
# apparaît (ex. temps réel).
# REDIS_URL="redis://localhost:6379"

# Paiement — CinetPay
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Paiement — Adullam (même format que CinetPay, une seule clé — pas de
# site_id séparé). PAYMENT_PROVIDER choisit explicitement "adullam" ou
# "cinetpay" (déduit automatiquement si omis — voir getActiveProviderName).
ADULLAM_API_KEY=""
ADULLAM_API_URL="https://api.adullam.dev"
PAYMENT_PROVIDER=""

# Email transactionnel — Resend (nécessite un domaine vérifié, non branché
# actuellement — voir PROMPT MASTER AUTHENTIFICATION §72)
RESEND_API_KEY=""

# Email transactionnel — Gmail SMTP (vérification d'email à l'inscription,
# PROMPT MASTER AUTHENTIFICATION §72 : règle introduite le 23/08/2026).
# GMAIL_APP_PASSWORD est un mot de passe d'application (compte Google avec
# validation en 2 étapes activée), jamais le mot de passe du compte.
# Dégradation propre si absent : le lien de vérification est journalisé
# côté serveur au lieu d'être envoyé par email (utile en développement).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# URL publique de l'application — sert à construire les liens absolus (email
# de vérification, cron des délais). En développement : http://localhost:3000.
APP_URL="http://localhost:3000"

# Stockage fichiers — Cloudflare R2 (compatible S3)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# Monitoring — Sentry
SENTRY_DSN=""

# WhatsApp Business API (optionnel, canal de contact externe)
WHATSAPP_API_TOKEN=""

# Canaux de contact (RÈGLES MÉTIER §57) — bouton WhatsApp (lien wa.me,
# format international sans "+" ni espaces, ex. "225XXXXXXXXX") et adresse
# e-mail de contact affichés sous les contenus concernés. Publics
# (NEXT_PUBLIC_) car utilisés pour construire des liens côté rendu.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# Secret partagé pour déclencher le balayage des délais en retard
# (POST /api/v1/deadlines/process, en-tête x-cron-secret) depuis un
# déclencheur externe planifié (cron) — aucun utilisateur n'est
# authentifié dans ce contexte.
DEADLINE_CRON_SECRET=""
